FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Public addresses only. The Foundry keystore holds the deployer's key.
DEPLOYER_ADDRESS=
AEGIS_SIGNER_ADDRESS=
AGENT_ADDRESS=

# Backend (Node 22.18+). ANVIL_BIN defaults to anvil on PATH.
ANVIL_BIN=anvil
PORT=4021
GUARD_VAULT_ADDRESS=0x4d0DA228a21F02c83ee3aF70E6702a489cD1019F
# OpenAI-compatible base URL including the provider's API version path.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional paths for npm run model:local
LLAMA_SERVER_BIN=llama-server
LLM_GGUF_PATH=
# Signer must match GuardVault.signer(). Configure only in the backend process.
AEGIS_SIGNER_PRIVATE_KEY=
# Set a Fuji facilitator that supports mUSDC, or a dedicated gas-funded relayer.
X402_FACILITATOR_URL=
RELAYER_PRIVATE_KEY=
X402_PAY_TO=0xA233579CAee3BCF9dE050e66b75FfF06A6EB6270
# Client only. Set this variable in the MCP process environment.
AEGIS_API_URL=http://127.0.0.1:4021
X402_PAYER_PRIVATE_KEY=

# Optional audit worker for a dedicated Avalanche test L1. Empty key disables writes.
AUDIT_L1_RPC_URL=
AUDIT_L1_CHAIN_ID=
AUDIT_LOG_CONTRACT_ADDRESS=
AUDIT_REPORTER_ADDRESS=
AUDIT_REPORTER_PRIVATE_KEY=
# Enable fallback only with a funded, authorized reporter on Fuji.
AUDIT_FALLBACK_RPC_URL=
AUDIT_FALLBACK_CONTRACT_ADDRESS=0x1c755dE79A9bFd54Cf0c559C97FfeDC58BF1Fec6
