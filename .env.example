# Public addresses only. The Foundry keystore holds the deployer's key.
DEPLOYER_ADDRESS=
AEGIS_SIGNER_ADDRESS=
AGENT_ADDRESS=

# Backend (Node 22.18+). ANVIL_BIN defaults to anvil on PATH.
ANVIL_BIN=anvil
PORT=4021
GUARD_VAULT_ADDRESS=0x4d0DA228a21F02c83ee3aF70E6702a489cD1019F
# OpenAI-compatible base URL including the provider's API version path.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Signer must match GuardVault.signer(). Configure only in the backend process.
AEGIS_SIGNER_PRIVATE_KEY=
# Set a Fuji facilitator that supports mUSDC, or a dedicated gas-funded relayer.
X402_FACILITATOR_URL=
RELAYER_PRIVATE_KEY=
