{
  "name": "aegis-avax",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "mcp-server",
    "frontend"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "proof:fuji": "node --env-file-if-exists=.env backend/scripts/fuji-proof.ts",
    "check:fuji": "node backend/scripts/check-fuji-proof.ts",
    "dev:backend": "npm run start -w backend",
    "dev:mcp": "npm run start -w mcp-server",
    "typecheck": "tsc --noEmit",
    "test:fork": "node --env-file-if-exists=.env backend/test/fork-smoke.ts",
    "test:audit": "node --env-file-if-exists=.env backend/test/audit-smoke.ts",
    "verify:audit": "node --env-file-if-exists=.env backend/scripts/verify-audit.ts",
    "test:extension": "node evals/extension-smoke.mjs",
    "test:fork:llm": "node --env-file-if-exists=.env backend/test/fork-smoke.ts --local-model",
    "model:local": "node --env-file-if-exists=.env backend/scripts/local-model.ts",
    "dev:demo": "node --env-file-if-exists=.env backend/scripts/demo.ts",
    "dev:web": "npm run dev -w frontend",
    "eval": "node --env-file-if-exists=.env evals/run_eval.ts",
    "test": "node --test backend/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
