{
  "manifest_version": 3,
  "name": "AegisAVAX",
  "description": "Đối chiếu tên miền và mô phỏng giao dịch trên demo Anvil.",
  "version": "0.1.0",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiểm tra với AegisAVAX"
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"]
    }
  ]
}
